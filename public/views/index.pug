doctype html
html(lang="en")
head
meta(charset="UTF-8")
meta(name="viewport", content="width=device-width, initial-scale=1.0")
title FitTraker

```
    link(
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    )

    link(
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    )

    link(rel="stylesheet", href="/css/styles.css")

body
    header
        h1.text-center FitTraker

    nav.navbar.navbar-expand-lg.bg-body-tertiary
        .container-fluid
            // Dashboard stays on the left
            a.navbar-brand(href="/") Dashboard

            button.navbar-toggler(
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNavDropdown"
                aria-controls="navbarNavDropdown"
                aria-expanded="false"
                aria-label="Toggle navigation"
            )
                span.navbar-toggler-icon

            // Links move to the right
            #navbarNavDropdown.collapse.navbar-collapse
                ul.navbar-nav.ms-auto

                    li.nav-item
                        a.nav-link.active(
                            aria-current="page"
                            href="/"
                        ) Home

                    li.nav-item
                        a.nav-link(href="/program") Program

                    li.nav-item
                        a.nav-link(href="#") Add Exercise

                    li.nav-item
                        a.nav-link(href="#") Contact Us

                    li.nav-item
                        a.nav-link(href="#") Account

    main
        h2 Welcome
        p Track your workouts and stay active.

        .container.my-4#calendar
            h2.text-center.mb-4 Calendar

            .calendar-container
                .calendar-row
                    calendar-event(
                        v-for="(day, index) in calendarDays"
                        :key="index"
                        :current-date="day.currentDate"
                        :block-info="day.blockInfo"
                        :button-block="day.buttonBlock"
                    )

    footer

    // Bootstrap
    script(
        src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"
    )

    script(
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
        integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
        crossorigin="anonymous"
    )

    // Vue 2
    script(src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js")

    // Vue Component
    script(src="/js/calendar.js")

    // Main Vue App
    script(src="/js/scripts.js")
```
